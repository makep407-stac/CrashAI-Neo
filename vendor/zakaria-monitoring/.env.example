# Copy to a private local environment file; never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Enter values you already hold locally. Never send them in chat.
ZAKARIA_USER_TOKEN=
ZAKARIA_SESSION=
ZAKARIA_ACCESS_TOKEN=
ZAKARIA_ACCOUNT_ID=

# Optional WebSocket settings
WS_REF=1
WS_GR=1529
WS_WHENCE=55
WS_FCOUNTRY=125
WS_APP_GUID=games-web-host-b2c-web-v3
WS_LANGUAGE=fr
WS_VERSION=1.5
COLLECTOR_RECONNECT_SECONDS=15
LOG_LEVEL=INFO
